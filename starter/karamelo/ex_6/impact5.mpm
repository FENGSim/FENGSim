#####################################################
#               UNITS: GPa, mm, ms, oC              #
#####################################################
# Metal cutting from Ambati et all
# Application of material point methods for cutting process simulations

# material properties for the steel plate

E   = 211
nu  = 0.33
rho = 7.75e-06

K = E/(3*(1-2*nu))
G = E/(2*(1+nu))

# Johnson-Cook flow parameters
sigmay = 980e-3
B      = 2
C      = 0
epsdot0= 1e-3
n      = 0.83
m      = 0

# Johnson-Cook damage parameters
d1 = 0.05
d2 = 0.8
d3 = -0.44
d4 = 0
d5 = 0

# temperature: eos and plastic work
S = 1.5
c0 = 5166
Gamma = 2.17
chi = 0.9
cp = 510
cv = 510
Tr = 25
Tm = 1300
alpha = 1
kappa = 44e-06

# problem dimensions
L = 1
H = 0.3

FLIP=0.99
method(tlmpm, FLIP, linear, FLIP)
#method(tlmpm, FLIP, linear, FLIP, thermo-mechanical)

N = 100
cellsize = 1/N
dimension(2,0,L,0,H,cellsize)

# -----------MATERIALS ----------------#
# EOS, strengh, damage and temperature

eos(eoss, shock, rho, K, c0, S, Gamma, cv, Tr, 0, 0)

strength(strengthjc, johnson_cook, G, sigmay, B, n, epsdot0, C, m, Tr, Tm)

temperature(tpw, plastic_work, chi, cp, kappa, alpha, Tr, Tm)

damage(damagejc, damage_johnson_cook, d1, d2, d3, d4, d5, epsdot0, Tr, Tm)

#material(mat, eos-strength, eoss, strengthjc)
material(mat, eos-strength, eoss, strengthjc, damagejc)
#material(mat, eos-strength, eoss, strengthjc, damagejc, tpw)

# -----------SOLIDS ----------------#
# defined using: geometry, material, PPC per 1 direction
region(work-piece, block, 0, L, 0, H)
solid(piece, region, work-piece, 1, mat, cellsize, Tr)

# initial conditions
group(gpart, particles, region, work-piece, solid, piece)
fix(v0part, initial_velocity_particles, gpart, 0, 0, NULL)

# boundary conditions
region(bc1, block, -INF, INF, -INF, 0)
group(gbc1, nodes, region, bc1, solid, piece)
fix(BC1, velocity_nodes, gbc1, 0, 0, NULL)

region(bc2, block, -INF, 0, -INF, INF)
group(gbc2, nodes, region, bc2, solid, piece)
fix(BC2, velocity_nodes, gbc2, 0, 0, NULL)

# cutting tool
fix(cutting-tool, cuttingtool, gpart, 100, 1-cellsize/2-100*time, 0.2, 0, -100, 0, 0, 10+1-cellsize/2-100*time, 0.2+0.5, 1-cellsize/2-100*time+2, 10+0.2)

# output
dumping_interval = 20
dump(dump1, all, particle, dumping_interval, dump_p.*.LAMMPS, x, y, z)
dump(dump2, all, grid, dumping_interval, dump_g.*.LAMMPS, x, y, z)

# run
set_dt(0.000001)
#run(1000)
run_time(0.005)