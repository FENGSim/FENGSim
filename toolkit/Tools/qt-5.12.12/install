# for ubuntu 24.04 there is a package (xkbcommon) version is too new, please use ubuntu 22.04 and 20.04 is OK
# could compile qt 5.12.12 in ubuntu 22.04 docker and use it on the host computer 24.04 is OK
# you need to copy qt.conf to 5.12.12/bin/ and add QT_PLUGIN_PATH=./../../toolkit/Tools/qt-5.12.12/5.12.12/plugins using qtcreator
# apt install qtcreator and add qmake in 5.12.12/bin

#wget https://download.qt.io/archive/qt/5.12/5.12.12/single/qt-everywhere-src-5.12.12.tar.xz
#tar -xJf qt-everywhere-src-5.12.12.tar.xz
cd qt-everywhere-src-5.12.12
mkdir build
cd build
./../configure --prefix=./../../5.12.12 -xcb -xcb-xlib -xcb-xinput -nomake examples -nomake tests -skip qtwebengine -skip qtmultimedia -skip qtvirtualkeyboard -skip qtlocation
make -j8
make install
cd ..
cd ..
cp qt.conf 5.12.12/bin

