package="jq"

if dpkg -s "$package" &> /dev/null; then
    echo "$package is ready."
else
    echo "install $package ..."
    sudo apt-get update
    sudo apt-get install -y "$package"
fi

echo "$1"

if [ "$1" = "occt" ]; then
   occt_dir=$(jq -r '.occt.dir' dep.json) # -r remove ""
   echo $occt_dir
   occt_install=$PWD/occt
   cd ../../$occt_dir
   echo $occt_install
fi	
